{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPN Decryptor",
  "version": "1.0.0",
  "identifier": "com.tendream.vpndecryptor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "رمزگشا و تبدیل‌گر کانفیگ‌های VPN",
        "width": 1220,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
